NODE_ENV=development
PORT=3000

# --- Database ---
# Local Postgres / Vercel Preview against a non-pooled dev database: the two
# can be identical.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app?schema=public
#
# Against Supabase in production, these must differ. Supabase gives you two
# connection strings (Project Settings -> Database):
#   DATABASE_URL = the "Transaction" pooler string, port 6543 — the app uses
#                   this for every request. Serverless means many short-lived
#                   function instances each wanting a Postgres connection;
#                   the pooler is what keeps that from exhausting Supabase's
#                   connection limit. Append `?pgbouncer=true&connection_limit=1`
#                   (Prisma's documented flags for a transaction-mode pooler).
#   DIRECT_URL   = the "Direct connection" string, port 5432 — only
#                   `prisma migrate` uses this. A pooler in transaction mode
#                   cannot run migrations (they need session-level features
#                   the pooler doesn't provide), so this must bypass it.
# Example:
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- Cross-origin requests ---
# Comma-separated browser origins allowed to call this API, e.g. the deployed
# frontend's URL(s). Empty by default: CORS stays off, and a browser-based
# frontend gets CORS errors until this is set. Non-browser callers (curl,
# server-to-server) are unaffected either way — CORS is a browser mechanism.
CORS_ORIGINS=

# --- Supabase auth ---
# Project URL; the JWT issuer and JWKS endpoint are derived from it.
SUPABASE_URL=https://your-project.supabase.co
# Legacy projects only: the shared HS256 secret. Leave unset to verify via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- KYC document storage (private bucket) ---
AWS_REGION=eu-west-2
KYC_S3_BUCKET=cleaning-app-kyc-documents
# Omit both keys in production so the SDK resolves the task/pod role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local development against MinIO/LocalStack:
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
# Customer-managed key for SSE-KMS. Unset falls back to SSE-S3.
KYC_S3_KMS_KEY_ID=

KYC_UPLOAD_URL_TTL_SECONDS=300
KYC_DOWNLOAD_URL_TTL_SECONDS=120
KYC_MAX_FILE_SIZE_BYTES=10485760
