NODE_ENV=development
PORT=3000

# --- Database ---
# Local Postgres / Vercel Preview against a non-pooled dev database: the two
# can be identical.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cleaning_app?schema=public
#
# Against Supabase in production, these must differ. Supabase gives you two
# connection strings (Project Settings -> Database):
#   DATABASE_URL = the "Transaction" pooler string, port 6543 — the app uses
#                   this for every request. Serverless means many short-lived
#                   function instances each wanting a Postgres connection;
#                   the pooler is what keeps that from exhausting Supabase's
#                   connection limit. Append `?pgbouncer=true&connection_limit=1`
#                   (Prisma's documented flags for a transaction-mode pooler).
#   DIRECT_URL   = the "Direct connection" string, port 5432 — only
#                   `prisma migrate` uses this. A pooler in transaction mode
#                   cannot run migrations (they need session-level features
#                   the pooler doesn't provide), so this must bypass it.
# Example:
#   DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# --- Cross-origin requests ---
# Comma-separated browser origins allowed to call this API, e.g. the deployed
# frontend's URL(s). Empty by default: CORS stays off, and a browser-based
# frontend gets CORS errors until this is set. Non-browser callers (curl,
# server-to-server) are unaffected either way — CORS is a browser mechanism.
CORS_ORIGINS=

# --- Supabase auth ---
# Project URL; the JWT issuer and JWKS endpoint are derived from it.
SUPABASE_URL=https://your-project.supabase.co
# Legacy projects only: the shared HS256 secret. Leave unset to verify via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- KYC document storage (private bucket, any S3-compatible store) ---
# Not the standard AWS_* names on purpose: serverless hosts (Vercel, Lambda)
# set AWS_REGION and AWS_* credentials for their own role, which would
# silently replace yours.
#
# Supabase Storage (what production uses):
#   KYC_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   KYC_S3_REGION=<the project's region, e.g. eu-west-1>
#   KYC_S3_FORCE_PATH_STYLE=true
#   KYC_S3_ENCRYPTION=provider-managed   # Supabase encrypts at rest itself
#   KYC_S3_ACCESS_KEY_ID / KYC_S3_SECRET_ACCESS_KEY from
#   Project Settings -> Storage -> S3 Connection
#
# AWS S3: leave KYC_S3_ENDPOINT unset and use sse-s3 or sse-kms.
KYC_S3_REGION=eu-west-2
KYC_S3_BUCKET=kyc-documents
# Both or neither. Neither only where the default credential chain is your own
# identity (ECS/EKS); required on Vercel.
KYC_S3_ACCESS_KEY_ID=
KYC_S3_SECRET_ACCESS_KEY=
# KYC_S3_ENDPOINT=http://localhost:9000   # MinIO / LocalStack
KYC_S3_FORCE_PATH_STYLE=false
# sse-s3 (default) | sse-kms (needs KYC_S3_KMS_KEY_ID) | provider-managed
KYC_S3_ENCRYPTION=sse-s3
# KYC_S3_KMS_KEY_ID=

KYC_UPLOAD_URL_TTL_SECONDS=300
KYC_DOWNLOAD_URL_TTL_SECONDS=120
KYC_MAX_FILE_SIZE_BYTES=10485760

# --- Payments (Chapa, Ethiopia) ---
# Chapa dashboard -> Settings -> API. The SECRET key (CHASECK_TEST-… while
# testing), never the public CHAPUBK… one — config validation rejects that.
CHAPA_SECRET_KEY=CHASECK_TEST-replace_me
# Chapa dashboard -> Settings -> Webhooks: set the URL to
# <API URL>/api/v1/payments/webhook and choose a long random "secret hash".
# The same value goes here; Chapa signs every webhook with it.
CHAPA_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
# Where the customer's browser lands after checkout. Until a frontend page
# exists, the API's own landing endpoint works:
#   https://<API host>/api/v1/payments/return
PAYMENT_RETURN_URL=http://localhost:3000/api/v1/payments/return
# This API's public URL. Optional: when set, Chapa also calls back after each
# checkout (one more way a payment is noticed, besides the webhook).
# PUBLIC_API_URL=https://cleaning-app-api.vercel.app
# Basis points: 1500 = 15% platform fee; 5000 = 50% of the price forfeited by a
# customer cancelling within 24 hours of the start (passed to the cleaner).
PLATFORM_FEE_BPS=1500
LATE_CANCELLATION_FEE_BPS=5000
