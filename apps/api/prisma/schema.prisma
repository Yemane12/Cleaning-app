// Cleaning marketplace — data model
//
// Epic 1: Auth, Roles & KYC Verification Infrastructure.
// Identity is owned by Supabase Auth (`auth.users`). This schema mirrors the
// Supabase user id as `User.id` so a validated JWT `sub` maps straight onto a
// local row without a join table.

generator client {
  provider = "prisma-client-js"
  // Vercel's Node serverless functions run on an Amazon-Linux runtime, not
  // the Debian image this is normally generated on. Without this target the
  // client works locally and then fails at cold start in production with a
  // "query engine not found for this platform" error. If a Vercel build ever
  // reports a different missing target, add that exact string here.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // Serverless: many short-lived function instances, each wanting its own
  // Postgres connection — enough of them exhaust Supabase's connection limit
  // in minutes. `DATABASE_URL` points at Supabase's pooled connection
  // (Supavisor/PgBouncer, port 6543) for the app itself; `directUrl` is the
  // unpooled connection (port 5432) that `prisma migrate` needs, since a
  // transaction-mode pooler cannot run migrations. See .env.example.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Platform-wide role. Drives RBAC guards on every protected route.
enum UserRole {
  CUSTOMER
  CLEANER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// Lifecycle of a cleaner's identity verification.
enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  REJECTED
}

/// Documents a cleaner must supply before they can be matched to jobs.
enum KycDocumentType {
  ID_FRONT
  ID_BACK
  SELFIE
  PROOF_OF_ADDRESS
  RIGHT_TO_WORK
  DBS_CERTIFICATE
  INSURANCE_CERTIFICATE
}

enum KycDocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  VERIFIED
  REJECTED
}

model User {
  /// Mirrors `auth.users.id` from Supabase. Never generated locally.
  id        String     @id @db.Uuid
  email     String     @unique
  phone     String?
  fullName  String?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  cleanerProfile   CleanerProfile?
  kycDocuments     KycDocument[]
  reviewedDocuments KycDocument[]  @relation("KycDocumentReviewer")
  auditLogs        AuditLog[]
  addresses        Address[]
  bookingsAsCustomer Booking[]     @relation("CustomerBookings")
  bookingsAsCleaner  Booking[]     @relation("CleanerBookings")
  bookingEvents      BookingEvent[]

  @@index([role])
  @@map("users")
}

model CleanerProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio        String?
  hourlyRate Decimal? @db.Decimal(10, 2)

  /// IANA zone the cleaner's availability windows are expressed in.
  /// Stored per cleaner so a London rule of 09:00 stays 09:00 across a DST shift.
  timeZone String @default("Europe/London")

  kycStatus          KycStatus @default(NOT_STARTED)
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycRejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]

  @@index([kycStatus])
  @@map("cleaner_profiles")
}

/// One uploaded KYC file. The file itself lives in a private S3 bucket; only
/// the object key is persisted, and it is never returned to clients directly —
/// access is always brokered through a short-lived presigned URL.
model KycDocument {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        KycDocumentType
  status      KycDocumentStatus @default(PENDING_UPLOAD)
  storageKey  String            @unique
  contentType String
  fileSize    Int?
  checksum    String?

  uploadedAt      DateTime?
  reviewedAt      DateTime?
  reviewedById    String?  @db.Uuid
  reviewedBy      User?    @relation("KycDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
  @@index([status])
  @@map("kyc_documents")
}

/// Append-only trail for verification decisions. KYC review is a regulated
/// action, so every approve/reject is recorded with its actor.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Epic 2: Bookings & Scheduling
// ─────────────────────────────────────────────────────────────────────────────

enum ServiceCategory {
  STANDARD_CLEAN
  DEEP_CLEAN
  END_OF_TENANCY
  OFFICE_CLEAN
  CARPET_CLEAN
}

/// A bookable service. Prices are integer minor units (pence) — money is never
/// stored as a float, and never as a Decimal we would then do JS arithmetic on.
model Service {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  description String?
  category    ServiceCategory

  /// Starting duration for a quote; a customer may book longer.
  baseDurationMinutes   Int
  basePriceMinor        Int
  /// Added for each 30 minutes beyond baseDurationMinutes.
  pricePerHalfHourMinor Int
  currency              String @default("GBP")

  /// Retired services stay readable so historic bookings still resolve.
  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([active, category])
  @@map("services")
}

/// Where a clean happens. Owned by the customer, snapshotted onto the booking
/// by reference so edits to an address never rewrite a past booking's location.
model Address {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String?
  line1     String
  line2     String?
  city      String
  postcode  String
  country   String  @default("GB")
  notes     String?
  isDefault Boolean @default(false)

  /// Soft delete: an address referenced by a booking must not vanish.
  archivedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([userId, archivedAt])
  @@map("addresses")
}

/// A recurring weekly window, in the cleaner's own time zone.
model AvailabilityRule {
  id               String         @id @default(uuid()) @db.Uuid
  cleanerProfileId String         @db.Uuid
  cleanerProfile   CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, evaluated in CleanerProfile.timeZone.
  weekday Int
  /// Minutes from local midnight: 540 = 09:00, 1020 = 17:00.
  startMinute Int
  endMinute   Int

  createdAt DateTime @default(now())

  @@unique([cleanerProfileId, weekday, startMinute, endMinute])
  @@index([cleanerProfileId, weekday])
  @@map("availability_rules")
}

/// A one-off block of unavailability (holiday, appointment) that overrides the
/// recurring rules. Absolute instants, so it is unambiguous across zones.
model AvailabilityException {
  id               String         @id @default(uuid()) @db.Uuid
  cleanerProfileId String         @db.Uuid
  cleanerProfile   CleanerProfile @relation(fields: [cleanerProfileId], references: [id], onDelete: Cascade)

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  reason   String?

  createdAt DateTime @default(now())

  @@index([cleanerProfileId, startsAt, endsAt])
  @@map("availability_exceptions")
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_CLEANER
}

model Booking {
  id        String @id @default(uuid()) @db.Uuid
  /// Short human-quotable id for support ("BK-7Q2ZK4").
  reference String @unique

  customerId String @db.Uuid
  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id])
  cleanerId  String @db.Uuid
  cleaner    User   @relation("CleanerBookings", fields: [cleanerId], references: [id])

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id])
  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id])

  status BookingStatus @default(REQUESTED)

  scheduledStart  DateTime @db.Timestamptz(3)
  scheduledEnd    DateTime @db.Timestamptz(3)
  durationMinutes Int

  /// Snapshot of the quote at booking time, so a later price change to the
  /// service never silently repricizes work already agreed.
  quotedPriceMinor Int
  currency         String

  customerNotes String?

  acceptedAt         DateTime?
  declinedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  events    BookingEvent[]

  @@index([cleanerId, scheduledStart])
  @@index([customerId, scheduledStart])
  @@index([status, scheduledStart])
  @@map("bookings")
}

/// Append-only transition log. Every status change records who caused it.
model BookingEvent {
  id        String  @id @default(uuid()) @db.Uuid
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?        @db.Uuid
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason     String?

  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_events")
}
