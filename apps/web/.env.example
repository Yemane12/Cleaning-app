# Public settings, built into the browser bundle (all NEXT_PUBLIC_*). None of
# these are secrets: the API checks every token, and Supabase's publishable key
# is meant to be public.

# The API's base URL, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
